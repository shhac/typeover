# Used by oxfmt as the ignore list (oxfmt reads .gitignore + .prettierignore
# by default).

# Markdown: design-docs / README / skills are hand-edited with deliberate
# emphasis style (*italic*) and indented continuation lines. Default
# formatter rules flip * → _ and unindent continuations, which breaks
# rendering. Keep markdown out of the format pass until we want to opt in.
*.md

# Content YAML: hand-authored exercise content. Single-quoted strings are
# the author convention (Go/TS snippets contain ' rarely, " never). The
# default formatter flips ' → ", which is semantically a no-op but
# unhelpfully noisy and surprises authors.
src/content/**/*.yaml
src/content/**/*.yml

# Generated / lock / build artifacts
pnpm-lock.yaml
dist/
.astro/
node_modules/
