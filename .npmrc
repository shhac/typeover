auto-install-peers=true
strict-peer-dependencies=false

# Supply-chain mitigation: refuse to install any package version that
# was published less than 2 days ago. Newly-published malicious
# versions are usually caught within hours; waiting 48h dramatically
# reduces the blast radius of a typo-squat or compromised-maintainer
# attack. See https://pnpm.io/supply-chain-security.
minimum-release-age=2880
