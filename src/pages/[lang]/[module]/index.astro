---
import { getCollection, type CollectionEntry } from "astro:content";
import BaseLayout from "~/layouts/BaseLayout.astro";
import {
  Container,
  Heading,
  Stack,
  Text,
} from "~/components/ds";
import Breadcrumb from "~/components/curriculum/Breadcrumb.astro";
import ThemeCard from "~/components/curriculum/ThemeCard.astro";
import {
  buildCurriculumTree,
  byOrder,
  langHref,
  moduleHref,
  paramsForModule,
} from "~/lib/curriculum";
import { loadLangCollections } from "~/lib/curriculum-loaders";
import { formatBlock } from "~/lib/format-block";

/**
 * Module overview — `/[lang]/<module>`.
 *
 * Closes the design-docs/16 UX-F2 "breadcrumb badge lies"
 * finding. Before this route shipped, the breadcrumb's
 * "Foundations" link landed on the entire curriculum index,
 * not a module-specific page. Now the badge's destination
 * matches its label.
 *
 * Layout: hero with the module title + summary, then a card
 * grid of themes. Same theme-card shape as the /[lang] index's
 * accordion-expanded body so the visual rhythm matches when a
 * learner arrives from there.
 */

type Module = CollectionEntry<"modules">;

export async function getStaticPaths() {
  const modules = await getCollection("modules");
  return modules.flatMap((entry) => {
    const params = paramsForModule(entry.id);
    if (!params) return [];
    return [{ params, props: { entry } }];
  });
}

const { entry } = Astro.props;
const moduleData = entry.data;
const lang = moduleData.target;

const { modules: langModules, themes: langThemes, exercises: langExercises } =
  await loadLangCollections(lang);

const tree = buildCurriculumTree(langModules, langThemes, langExercises);
const node = tree.find((n) => n.module.id === entry.id);
if (!node) {
  throw new Error(`Module ${entry.id} not found in tree (curriculum data drift?)`);
}

/* Compute prev/next-module links for the "what's next" footer hint —
 * scoped to this language's modules only. */
const sorted = tree.slice().sort((a, b) => byOrder(a.module, b.module));
const idx = sorted.findIndex((n) => n.module.id === entry.id);
const prevModule = sorted[idx - 1]?.module;
const nextModule = sorted[idx + 1]?.module;
---

<BaseLayout
  title={`${moduleData.title} — typeover`}
  description={moduleData.summary}
>
  <main class="py-12 sm:py-20">
    <Container width="wide">
      <Stack gap="xl">
        <Breadcrumb
          crumbs={[
            { label: "Curriculum", href: langHref(lang) },
            { label: moduleData.title },
          ]}
        />

        {/* Module hero */}
        <Stack gap="sm">
          <Text tone="muted" size="xs" family="mono">
            module {moduleData.order} of {sorted.length}
          </Text>
          <Heading level={1}>{moduleData.title}</Heading>
          <Text tone="secondary" size="lg" as="div" class="ds-prose">
            <Fragment set:html={formatBlock(moduleData.summary)} />
          </Text>
        </Stack>

        {/* Themes */}
        <Stack gap="md" class="pt-4">
          <Heading level={2} size="xl">Themes</Heading>
          {node.themes.length === 0 ? (
            <Text tone="muted" size="sm" family="mono">
              No themes drafted for this module yet.
            </Text>
          ) : (
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              {node.themes.map(({ theme, firstExercise, exerciseCount, exerciseIds }) => (
                <ThemeCard
                  moduleOrder={moduleData.order}
                  theme={theme}
                  firstExercise={firstExercise}
                  exerciseCount={exerciseCount}
                  exerciseIds={exerciseIds}
                />
              ))}
            </div>
          )}
        </Stack>

        {/* Module nav */}
        <Stack direction="row" justify="between" align="center" wrap>
          {prevModule ? (
            <a
              href={moduleHref(prevModule.id)}
              class="text-fg-muted hover:text-fg-primary font-mono text-sm"
            >
              ← {prevModule.data.title}
            </a>
          ) : (
            <a
              href={langHref(lang)}
              class="text-fg-muted hover:text-fg-primary font-mono text-sm"
            >
              ← back to curriculum
            </a>
          )}
          {nextModule && (
            <a
              href={moduleHref(nextModule.id)}
              class="text-accent-primary hover:underline font-mono text-sm"
            >
              {nextModule.data.title} →
            </a>
          )}
        </Stack>
      </Stack>
    </Container>
  </main>
</BaseLayout>
