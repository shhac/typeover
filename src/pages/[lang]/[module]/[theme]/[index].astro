---
import { getCollection, type CollectionEntry } from "astro:content";
import BaseLayout from "~/layouts/BaseLayout.astro";
import {
  Container,
  Divider,
  Heading,
  Panel,
  Stack,
  Text,
} from "~/components/ds";
import Breadcrumb from "~/components/curriculum/Breadcrumb.astro";
import { Mcq } from "~/components/exercise/Mcq";
import { FillBlankWord } from "~/components/exercise/FillBlankWord";
import { FillBlankLineInput } from "~/components/exercise/FillBlankLineInput";
import { Freeform } from "~/components/exercise/Freeform";
import {
  exerciseHref,
  findAdjacentExercises,
  firstExerciseOfNextTheme,
  langHref,
  lastExerciseInModule,
  lastExerciseOfPreviousTheme,
  loadExerciseContext,
  moduleCompleteHref,
  moduleHref,
  paramsForExercise,
  themeHref,
} from "~/lib/curriculum";
import { LANG_DISPLAY } from "~/lib/lang";
import { formatBlock } from "~/lib/format-block";

type ExerciseEntry = CollectionEntry<"exercises">;

export async function getStaticPaths() {
  const exercises = await getCollection("exercises");
  return exercises.flatMap((entry) => {
    const params = paramsForExercise(entry.id);
    if (!params) return [];
    return [{ params, props: { entry } }];
  });
}

interface Props {
  entry: ExerciseEntry;
}

const { entry } = Astro.props;
const ex = entry.data;
const lang = ex.target;
const langLabel = LANG_DISPLAY[lang];

const [modules, themes, exercises] = await Promise.all([
  getCollection("modules"),
  getCollection("themes"),
  getCollection("exercises"),
]);
const ctx = loadExerciseContext(entry, { modules, themes });
if (!ctx) {
  throw new Error(
    `Exercise "${entry.id}" has a dangling parent reference (themeId="${ex.themeId}")`,
  );
}
const { module: moduleEntry, theme: themeEntry } = ctx;

/* "Next →" target priority — implemented as guarded early returns
 * so adding a fifth tier is one line, not a re-shuffled ternary
 * chain (design-docs/20 lens-3 finding):
 *   1. next exercise within the same theme
 *   2. first exercise of the next theme in the same module
 *   3. /go/<module>/complete (last in module)
 *   4. undefined → shell falls back to "Back to theme overview" */
function resolveNextExerciseHref(): string | undefined {
  const { next } = findAdjacentExercises(entry, exercises);
  if (next) return exerciseHref(next.id);
  const nextThemeFirst = firstExerciseOfNextTheme(entry, themes, exercises);
  if (nextThemeFirst) return exerciseHref(nextThemeFirst.id);
  const lastInModule = lastExerciseInModule(entry, themes, exercises);
  if (lastInModule) return moduleCompleteHref(lastInModule.moduleId);
  return undefined;
}
/* "← Previous" target — symmetric to next. No module-wrap fallback
 * (no concept of "previous module complete" page); if this is the
 * very first exercise of the curriculum the link is omitted and the
 * shell only shows the parent-theme breadcrumb-up. */
function resolvePrevExerciseHref(): string | undefined {
  const { prev } = findAdjacentExercises(entry, exercises);
  if (prev) return exerciseHref(prev.id);
  const prevThemeLast = lastExerciseOfPreviousTheme(entry, themes, exercises);
  if (prevThemeLast) return exerciseHref(prevThemeLast.id);
  return undefined;
}
const nextExerciseHref = resolveNextExerciseHref();
const prevExerciseHref = resolvePrevExerciseHref();
const parentThemeHref = themeHref(themeEntry.id);
---

<BaseLayout
  title={`${themeEntry.data.title} — typeover`}
  description={`Practice ${themeEntry.data.title} for TypeScript developers learning ${langLabel}.`}
  prevExerciseHref={prevExerciseHref}
  nextExerciseHref={nextExerciseHref}
>
  <main class="py-12 sm:py-20">
    <Container width="prose">
      <Stack gap="xl">
        <Stack gap="sm">
          <Breadcrumb
            crumbs={[
              { label: "Curriculum", href: langHref(lang) },
              {
                label: moduleEntry.data.title,
                href: moduleHref(moduleEntry.id),
                ariaLabel: `Up to ${moduleEntry.data.title} module overview`,
              },
              {
                label: themeEntry.data.title,
                href: parentThemeHref,
                ariaLabel: `Up to theme overview (${themeEntry.data.title})`,
              },
              { label: `exercise ${ex.order} · ${ex.type}` },
            ]}
          />
          <Heading level={1}>{themeEntry.data.title}</Heading>
        </Stack>

        <Panel padding="airy" tone="default">
          {ex.type === "mcq" && (
            <Mcq
              client:visible
              exerciseId={entry.id}
              prompt={ex.prompt}
              generator={ex.generator}
              hints={ex.hints}
              successNote={ex.successNote}
              nextExerciseHref={nextExerciseHref}
              themeHref={parentThemeHref}
            />
          )}
          {ex.type === "fill-word" && (
            <FillBlankWord
              client:visible
              exerciseId={entry.id}
              prompt={ex.prompt}
              generator={ex.generator}
              blanks={ex.blanks ?? []}
              hints={ex.hints}
              target={ex.target}
              successNote={ex.successNote}
              nextExerciseHref={nextExerciseHref}
              themeHref={parentThemeHref}
            />
          )}
          {ex.type === "fill-line" && ex.expectStdout !== undefined && (ex.runtime === "yaegi" || ex.runtime === "zig") && (
            <FillBlankLineInput
              client:only="solid-js"
              exerciseId={entry.id}
              prompt={ex.prompt}
              generator={ex.generator}
              blanks={ex.blanks ?? []}
              hints={ex.hints}
              expectStdout={ex.expectStdout}
              runtime={ex.runtime}
              alternateCanonicals={ex.alternateCanonicals}
              successNote={ex.successNote}
              nextExerciseHref={nextExerciseHref}
              themeHref={parentThemeHref}
            />
          )}
          {ex.type === "freeform" && ex.expectStdout !== undefined && ex.runtime !== "none" && (
            <Freeform
              client:only="solid-js"
              exerciseId={entry.id}
              prompt={ex.prompt}
              generator={ex.generator}
              hints={ex.hints}
              expectStdout={ex.expectStdout}
              runtime={ex.target === "rust" && ex.runtime === "server" ? "rust" : ex.runtime}
              successNote={ex.successNote}
              nextExerciseHref={nextExerciseHref}
              themeHref={parentThemeHref}
            />
          )}
        </Panel>

        <Divider />

        <Stack gap="sm">
          <Heading level={4}>About this theme</Heading>
          <Text tone="secondary" size="md" as="div" class="ds-prose">
            {themeEntry && <Fragment set:html={formatBlock(themeEntry.data.intro)} />}
          </Text>
        </Stack>
      </Stack>
    </Container>
  </main>
</BaseLayout>
