---
import BaseLayout from "~/layouts/BaseLayout.astro";
import {
  Badge,
  Button,
  ButtonLink,
  CodeBlock,
  Compare,
  Container,
  Divider,
  Eyebrow,
  Feedback,
  Heading,
  HintButton,
  Kbd,
  Panel,
  ProgressChip,
  RevealButton,
  Stack,
  StatBlock,
  Text,
} from "~/components/ds";
import Accordion from "~/components/ds/Accordion.astro";
import TrackCard from "~/components/ds/TrackCard.astro";
import Breadcrumb from "~/components/curriculum/Breadcrumb.astro";
import ThemeCard from "~/components/curriculum/ThemeCard.astro";
import { getCollection } from "astro:content";

/* Pull one real foundations theme + its first exercise for the
 * ThemeCard sample below. design-docs/15 pattern 11 — inventory
 * the curriculum-card surfaces alongside the DS primitives so a
 * contributor browsing this page sees the components a real
 * curriculum route would consume. */
const themes = await getCollection("themes");
const exercises = await getCollection("exercises");
const sampleTheme = themes.find((t) => t.id === "foundations/variables");
const sampleExerciseCount = sampleTheme
  ? exercises.filter((ex) => ex.data.themeId === sampleTheme.id).length
  : 0;
const sampleFirstExercise = sampleTheme
  ? exercises
      .filter((ex) => ex.data.themeId === sampleTheme.id)
      .sort((a, b) => a.data.order - b.data.order)[0]
  : undefined;

/*
 * Design-system inventory. Lives at /design-system per
 * design-docs/15 pattern 11 — moved off the homepage so the
 * landing page can lead with the course offering rather than
 * the DS contributor's catalogue.
 *
 * Anyone hacking on the DS opens this route intentionally;
 * learners never see it. The page is unlinked from the global
 * footer too — it's a contributor surface, not a learner one.
 */
---

<BaseLayout
  title="Design system — typeover"
  description="Inventory of the typeover design-system primitives."
>
  <main class="py-12 sm:py-20">
    <Container width="wide">
      <Stack gap="xl">
        <Stack gap="sm">
          <Heading level={1}>Design system</Heading>
          <Text tone="secondary" size="lg">
            Inventory of typeover's design-system primitives. Compose
            them — every page on the site is built from this list.
          </Text>
        </Stack>

        <Divider />

        {/* Example of <Compare> + filename labels — the killer
          * move for the TS → Go translation pattern. */}
        <Stack gap="sm">
          <Eyebrow>compare — side by side</Eyebrow>
          <Compare
            caption="<Compare> renders a <figure> + <figcaption> wrapping <Adaptive>. Side-by-side at ≥1024px, stacked below. Used wherever TS↔Go translation is the point."
          >
            <CodeBlock lang="ts" filename="users.ts">{`type User = {
  id: string;
  name: string;
};

function greet(u: User) {
  return \`hi \${u.name}\`;
}`}</CodeBlock>
            <CodeBlock lang="go" filename="users.go">{`type User struct {
    ID   string
    Name string
}

func greet(u User) string {
    return "hi " + u.Name
}`}</CodeBlock>
          </Compare>
        </Stack>

        <Divider />

        <Stack gap="md">
          <Eyebrow>primitives</Eyebrow>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-x-10 gap-y-8">
            <Stack gap="xs">
              <Eyebrow tone="primary">buttons</Eyebrow>
              <Stack direction="row" gap="sm" wrap>
                <Button variant="primary">Primary</Button>
                <Button variant="secondary">Secondary</Button>
                <Button variant="ghost">Ghost</Button>
                <Button variant="danger">Danger</Button>
              </Stack>
            </Stack>

            <Stack gap="xs">
              <Eyebrow tone="ts">badges</Eyebrow>
              <Stack direction="row" gap="sm" wrap>
                <Badge>default</Badge>
                <Badge variant="ts">typescript</Badge>
                <Badge variant="go">golang</Badge>
                <Badge variant="primary">focus</Badge>
                <Badge variant="success">passed</Badge>
                <Badge variant="error">failed</Badge>
              </Stack>
            </Stack>

            <Stack gap="xs">
              <Eyebrow tone="go">keys</Eyebrow>
              <Stack direction="row" gap="sm" align="center">
                <Kbd>⌘</Kbd>
                <Kbd>K</Kbd>
                <Text tone="muted" size="sm" family="mono">open palette</Text>
              </Stack>
            </Stack>

            <Stack gap="xs">
              <Eyebrow tone="muted">tones</Eyebrow>
              <Stack gap="xs">
                <Text tone="primary">Primary — main reading text</Text>
                <Text tone="secondary">Secondary — supporting prose</Text>
                <Text tone="muted">Muted — captions and hints</Text>
                <Text tone="faint">Faint — barely-there metadata</Text>
              </Stack>
            </Stack>

            <Stack gap="xs">
              <Eyebrow tone="muted">progress chips</Eyebrow>
              <Stack gap="xs">
                <ProgressChip kind="theme" passed={6} total={9} />
                <ProgressChip kind="exercise" seen={3} passed={2} />
              </Stack>
            </Stack>

            <Stack gap="xs">
              <Eyebrow tone="muted">eyebrows</Eyebrow>
              <Stack gap="xs">
                <Eyebrow>default</Eyebrow>
                <Eyebrow tone="muted">muted</Eyebrow>
                <Eyebrow tone="primary">amber</Eyebrow>
                <Eyebrow tone="ts">typescript</Eyebrow>
                <Eyebrow tone="go">golang</Eyebrow>
              </Stack>
            </Stack>

            <Stack gap="xs">
              <Eyebrow tone="muted">stat block</Eyebrow>
              <Stack direction="row" gap="md">
                <StatBlock value={6} label="themes" />
                <StatBlock value={54} label="exercises" />
                <StatBlock value={12} label="hints" tone="secondary" />
              </Stack>
            </Stack>

            <Stack gap="xs">
              <Eyebrow tone="muted">button link</Eyebrow>
              <Stack direction="row" gap="sm" wrap>
                <ButtonLink href="#" variant="primary">Primary nav</ButtonLink>
                <ButtonLink href="#" variant="secondary">Secondary nav</ButtonLink>
              </Stack>
            </Stack>

            <Stack gap="xs">
              <Eyebrow tone="muted">feedback</Eyebrow>
              <Stack gap="xs">
                <Feedback status="correct">Correct — and idiomatic.</Feedback>
                <Feedback status="incorrect">Not quite. Try again or reveal the answer.</Feedback>
                <Feedback status="pending">Checking…</Feedback>
              </Stack>
            </Stack>

            <Stack gap="xs">
              <Eyebrow tone="muted">hint button</Eyebrow>
              <HintButton
                hints={[
                  "Layer 1 — observational.",
                  "Layer 2 — pointed.",
                  "Layer 3 — the answer.",
                ]}
              />
            </Stack>

            <Stack gap="xs">
              <Eyebrow tone="muted">reveal button</Eyebrow>
              <RevealButton canonical="package main\nfunc main() {}" lang="go" />
            </Stack>

            <Stack gap="xs">
              <Eyebrow tone="muted">panel</Eyebrow>
              <Panel padding="default" tone="default">
                <Text tone="muted" size="sm">A Panel — surface container with hairline.</Text>
              </Panel>
              <Panel padding="default" tone="default" label="LABEL STRIP" accent="primary">
                <Text tone="muted" size="sm">With a labelled top strip (use sparingly).</Text>
              </Panel>
            </Stack>
          </div>
        </Stack>

        <Divider />

        <Stack gap="md">
          <Eyebrow>composed surfaces</Eyebrow>

          <Stack gap="xs">
            <Eyebrow tone="muted">accordion (native &lt;details&gt;)</Eyebrow>
            <Accordion defaultOpen={true}>
              <Heading level={3} size="lg" slot="summary">Open by default</Heading>
              <Fragment slot="meta">3 items</Fragment>
              <Text tone="muted" size="sm">
                Accordion body. Click the summary to collapse.
              </Text>
            </Accordion>
            <Accordion>
              <Heading level={3} size="lg" slot="summary">Closed by default</Heading>
              <Fragment slot="meta">scaffolded</Fragment>
              <Text tone="muted" size="sm">Body hidden until clicked.</Text>
            </Accordion>
          </Stack>

          <Stack gap="xs">
            <Eyebrow tone="muted">track card</Eyebrow>
            <TrackCard status="available">
              <Heading level={3} size="xl" slot="title">
                <span class="text-accent-go">Go</span> for TypeScript devs
              </Heading>
              <Fragment slot="dek">One-line dek explaining the track.</Fragment>
              <Stack gap="xs" slot="modules">
                <Text tone="muted" size="sm" family="mono">1. Foundations · ready</Text>
                <Text tone="faint" size="sm" family="mono">2–7. soon</Text>
              </Stack>
              <ButtonLink href="#" variant="primary">Start</ButtonLink>
            </TrackCard>
          </Stack>

          <Stack gap="xs">
            <Eyebrow tone="muted">mobile key bar</Eyebrow>
            <Text tone="muted" size="sm">
              <code class="font-mono">&lt;MobileKeyBar&gt;</code> renders at the bottom of the
              viewport on <code class="font-mono">&lt;1024px</code> only. Resize the window
              to see it; it overlays the Go symbol bank above the soft keyboard.
            </Text>
          </Stack>

          <Stack gap="xs">
            <Eyebrow tone="muted">breadcrumb</Eyebrow>
            <Breadcrumb
              crumbs={[
                { label: "Curriculum", href: "/go" },
                {
                  label: "Foundations",
                  href: "/go/foundations",
                  ariaLabel: "Up to Foundations module overview",
                },
                {
                  label: "Variables and declarations",
                  href: "/go/foundations/variables",
                  ariaLabel: "Up to theme overview (Variables and declarations)",
                },
                { label: "exercise 1 · mcq" },
              ]}
            />
            <Text tone="muted" size="sm">
              <code class="font-mono">&lt;Breadcrumb&gt;</code> takes a
              <code class="font-mono">crumbs: Crumb[]</code> array; the last entry without
              <code class="font-mono">href</code> renders as the active-leaf span. Used
              across the <code class="font-mono">/go/*</code> routes.
            </Text>
          </Stack>

          {sampleTheme && (
            <Stack gap="xs">
              <Eyebrow tone="muted">theme card</Eyebrow>
              <div class="max-w-md">
                <ThemeCard
                  moduleOrder={1}
                  theme={sampleTheme}
                  firstExercise={sampleFirstExercise}
                  exerciseCount={sampleExerciseCount}
                />
              </div>
              <Text tone="muted" size="sm">
                <code class="font-mono">&lt;ThemeCard&gt;</code> renders the
                curriculum-grid card on <code class="font-mono">/go</code> and
                <code class="font-mono">/go/[module]</code> — order tag, title link,
                truncated intro, ready badge, overview + start anchors. Takes the
                parent module's order, the theme collection entry, the first
                exercise (optional), and the count.
              </Text>
            </Stack>
          )}
        </Stack>

        <Divider />

        <Stack gap="sm">
          <Eyebrow>further reading</Eyebrow>
          <Text tone="muted" size="sm">
            Design rationale lives in
            <code class="font-mono">design-docs/</code> at the repo
            root. Theme axes (colour / density / shape / style)
            are in 13 and 14; the docs-site patterns this DS is
            built against are in 15.
          </Text>
        </Stack>
      </Stack>
    </Container>
  </main>
</BaseLayout>
