---
import BaseLayout from "~/layouts/BaseLayout.astro";
import { Container, Heading, Stack, Text } from "~/components/ds";
import { AppearancePicker } from "~/components/settings/AppearancePicker";

/*
 * Learner settings. Five appearance axes — colour theme, density,
 * shape, style, palette — per design-docs/13 + 14 + 22. Will grow
 * to hold any other learner-controlled preference that doesn't fit
 * inside an exercise (keybindings, reduced-motion override, etc.).
 */
---

<BaseLayout title="Settings — typeover" description="Configure your typeover preferences.">
  <main class="py-12 sm:py-20">
    <Container width="default">
      <Stack gap="xl">
        <Stack gap="sm">
          <Heading level={1}>Settings</Heading>
          <Text tone="muted" size="sm">
            Preferences are stored locally in your browser. Nothing leaves
            your device.
          </Text>
        </Stack>

        <Stack gap="md">
          <Stack gap="xs">
            <Heading level={2} size="xl">Appearance</Heading>
            <Text tone="muted" size="sm">
              Five axes — pick what reads best for you. Changes apply
              instantly across the whole site, and each flip surfaces
              an undo toast.
            </Text>
          </Stack>
          <AppearancePicker client:only="solid-js" />
        </Stack>
      </Stack>
    </Container>
  </main>
</BaseLayout>
