---
import { getCollection, type CollectionEntry } from "astro:content";
import BaseLayout from "~/layouts/BaseLayout.astro";
import {
  Badge,
  Container,
  Divider,
  Heading,
  Panel,
  Stack,
  Text,
} from "~/components/ds";
import { Mcq } from "~/components/exercise/Mcq";
import { FillBlankWord } from "~/components/exercise/FillBlankWord";
import { FillBlankLine } from "~/components/exercise/FillBlankLine";
import { FillBlankLineInput } from "~/components/exercise/FillBlankLineInput";
import { Freeform } from "~/components/exercise/Freeform";
import {
  exerciseHref,
  findAdjacentExercises,
  loadExerciseContext,
  paramsForExercise,
  themeHref,
} from "~/lib/curriculum";
import { formatInline } from "~/lib/format-inline";
import { formatBlock } from "~/lib/format-block";

type ExerciseEntry = CollectionEntry<"exercises">;

export async function getStaticPaths() {
  const exercises = await getCollection("exercises");
  return exercises.flatMap((entry) => {
    const params = paramsForExercise(entry.id);
    if (!params) return [];
    return [{ params, props: { entry } }];
  });
}

interface Props {
  entry: ExerciseEntry;
}

const { entry } = Astro.props;
const ex = entry.data;

const [modules, themes, exercises] = await Promise.all([
  getCollection("modules"),
  getCollection("themes"),
  getCollection("exercises"),
]);
const ctx = loadExerciseContext(entry, { modules, themes });
if (!ctx) {
  throw new Error(
    `Exercise "${entry.id}" has a dangling parent reference (themeId="${ex.themeId}")`,
  );
}
const { module: moduleEntry, theme: themeEntry } = ctx;

const { next } = findAdjacentExercises(entry, exercises);
const nextExerciseHref = next ? exerciseHref(next.id) : undefined;
const parentThemeHref = themeHref(themeEntry.id);
---

<BaseLayout
  title={`${themeEntry.data.title} — typeover`}
  description={`Practice ${themeEntry.data.title} for TypeScript developers learning Go.`}
>
  <main class="py-12 sm:py-20">
    <Container width="default">
      <Stack gap="xl">
        <Stack gap="sm">
          <Stack direction="row" gap="sm" align="center" wrap>
            <a
              href="/go"
              class="inline-flex hover:opacity-80 rounded-sm focus-visible:outline-2 focus-visible:outline-accent-amber"
              aria-label={`Up to curriculum (${moduleEntry.data.title})`}
            >
              <Badge variant="amber">{moduleEntry.data.title}</Badge>
            </a>
            <Text tone="muted" size="sm" family="mono">→</Text>
            <a
              href={parentThemeHref}
              class="inline-flex hover:opacity-80 rounded-sm focus-visible:outline-2 focus-visible:outline-accent-amber"
              aria-label={`Up to theme overview (${themeEntry.data.title})`}
            >
              <Badge variant="default" outline>{themeEntry.data.title}</Badge>
            </a>
            <Text tone="muted" size="sm" family="mono">·</Text>
            <Text tone="muted" size="sm" family="mono">
              exercise {ex.order} · {ex.type}
            </Text>
          </Stack>
          <Heading level={1}>{themeEntry.data.title}</Heading>
        </Stack>

        <Panel padding="airy" tone="default">
          {ex.type === "mcq" && (
            <Mcq
              client:visible
              exerciseId={entry.id}
              prompt={ex.prompt}
              generator={ex.generator}
              hints={ex.hints}
              nextExerciseHref={nextExerciseHref}
              themeHref={parentThemeHref}
            />
          )}
          {ex.type === "fill-word" && (
            <FillBlankWord
              client:visible
              exerciseId={entry.id}
              prompt={ex.prompt}
              generator={ex.generator}
              blanks={ex.blanks ?? []}
              hints={ex.hints}
              nextExerciseHref={nextExerciseHref}
              themeHref={parentThemeHref}
            />
          )}
          {ex.type === "fill-line" && ex.expectStdout !== undefined && ex.runtime === "yaegi" && (
            <FillBlankLineInput
              client:only="solid-js"
              exerciseId={entry.id}
              prompt={ex.prompt}
              generator={ex.generator}
              blanks={ex.blanks ?? []}
              hints={ex.hints}
              expectStdout={ex.expectStdout}
              runtime={ex.runtime}
              nextExerciseHref={nextExerciseHref}
              themeHref={parentThemeHref}
            />
          )}
          {ex.type === "fill-line" && ex.expectStdout === undefined && (
            <FillBlankLine
              client:visible
              exerciseId={entry.id}
              prompt={ex.prompt}
              generator={ex.generator}
              blanks={ex.blanks ?? []}
              hints={ex.hints}
              nextExerciseHref={nextExerciseHref}
              themeHref={parentThemeHref}
            />
          )}
          {ex.type === "freeform" && ex.expectStdout !== undefined && ex.runtime !== "none" && (
            <Freeform
              client:only="solid-js"
              exerciseId={entry.id}
              prompt={ex.prompt}
              generator={ex.generator}
              hints={ex.hints}
              expectStdout={ex.expectStdout}
              runtime={ex.runtime}
              nextExerciseHref={nextExerciseHref}
              themeHref={parentThemeHref}
            />
          )}
        </Panel>

        <Divider />

        <Stack gap="sm">
          <Heading level={4}>About this theme</Heading>
          <Text tone="secondary" size="md" as="div" class="ds-prose">
            {themeEntry && <Fragment set:html={formatBlock(themeEntry.data.intro)} />}
          </Text>
        </Stack>
      </Stack>
    </Container>
  </main>
</BaseLayout>
