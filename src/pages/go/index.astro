---
import { getCollection } from "astro:content";
import BaseLayout from "~/layouts/BaseLayout.astro";
import {
  ButtonLink,
  CodeBlock,
  Compare,
  Container,
  Divider,
  Eyebrow,
  Heading,
  LangCrumbs,
  Stack,
  Text,
} from "~/components/ds";
import Accordion from "~/components/ds/Accordion.astro";
import ThemeCard from "~/components/curriculum/ThemeCard.astro";
import { buildCurriculumTree, exerciseHref, summariseCoverage } from "~/lib/curriculum";
import { formatInline } from "~/lib/format-inline";

/**
 * Curriculum overview. Browse-anywhere tree of modules → themes →
 * first exercise. The recommended-path highlight + progress chips
 * arrive once the per-theme progress hook lands.
 */

const [modules, themes, exercises] = await Promise.all([
  getCollection("modules"),
  getCollection("themes"),
  getCollection("exercises"),
]);

const tree = buildCurriculumTree(modules, themes, exercises);
const coverage = summariseCoverage(tree);
const coveragePct =
  coverage.totalThemes === 0
    ? 0
    : Math.round((coverage.themesCovered / coverage.totalThemes) * 100);
---

<BaseLayout
  title="typeover — Go curriculum"
  description="Browse the full typeover curriculum for Go."
>
  <main class="py-12 sm:py-20">
    <Container width="wide">
      <Stack gap="xl">
        <Stack gap="sm">
          <LangCrumbs />
          <Heading level={1}>Curriculum</Heading>
          <Text tone="secondary" size="lg">
            Seven modules. Start anywhere — the recommended path is in order, but
            every theme is browsable. Themes without exercises yet are visible
            so you can see what's coming.
          </Text>
          {/*
            * Coverage chip — honest about how much is actually authored
            * versus scaffolded. Sourced from the same content collection
            * Astro builds against; cf. `pnpm content:report` for the CLI
            * equivalent. design-docs/25.
            */}
          <div
            class="flex flex-col sm:flex-row gap-2 sm:gap-4 mt-2 font-mono text-xs text-fg-muted"
            aria-label="Curriculum authoring progress"
          >
            <span>
              <span class="text-fg-secondary">{coverage.modulesComplete}</span> modules
              complete · <span class="text-fg-secondary">{coverage.modulesPartial}</span> partial
              · <span class="text-fg-secondary">{coverage.modulesEmpty}</span> scaffolded
            </span>
            <span aria-hidden="true">·</span>
            <span>
              <span class="text-fg-secondary">{coverage.themesCovered}</span>/{coverage.totalThemes}
              themes authored ({coveragePct}%)
            </span>
            <span aria-hidden="true">·</span>
            <span>
              <span class="text-fg-secondary">{coverage.totalExercises}</span> exercises
            </span>
          </div>
        </Stack>

        <Stack gap="sm">
          <Eyebrow>the wedge</Eyebrow>
          <Compare
            caption="Same intent, two syntaxes. typeover's whole shape is teaching the second one by leaning on what you already know about the first."
          >
            <CodeBlock lang="ts" filename="variables.ts">{`let count: number = 5;
const PI = 3.14;

function double(n: number): number {
  return n * 2;
}`}</CodeBlock>
            <CodeBlock lang="go" filename="variables.go">{`count := 5
const PI = 3.14

func double(n int) int {
    return n * 2
}`}</CodeBlock>
          </Compare>
        </Stack>

        <Divider />

        <Stack gap="lg">
          {tree.map(({ module, themes }) => {
            /* Module 1 (Foundations) is the launch-gate content; it
             * opens by default so a fresh visitor lands on
             * shippable material. Modules 2-7 are scaffolded — they
             * collapse so the page doesn't read as a wall. design-
             * docs/15 pattern 10. */
            const isShippedModule = module.data.order === 1;
            const themeCount = themes.length;
            const totalExercises = themes.reduce(
              (n, { exerciseCount }) => n + exerciseCount,
              0,
            );
            /* Module-level "start here" CTA — design-docs/16 F-10.
             * Without this a fresh /go visitor sees a flat tree with
             * no recommended path; the open Module 1 accordion needs
             * a dominant action above the theme grid. */
            const moduleFirstExercise = themes.find((t) => t.firstExercise)?.firstExercise;
            return (
              <Accordion defaultOpen={isShippedModule}>
                <Heading level={2} size="2xl" slot="summary">
                  <span class="text-fg-faint font-mono mr-3">{module.data.order}.</span>
                  {module.data.title}
                </Heading>
                <Fragment slot="meta">
                  {totalExercises > 0
                    ? `${themeCount} themes · ${totalExercises} exercises`
                    : `${themeCount} themes · scaffolded`}
                </Fragment>
              <Text tone="secondary" size="md" class="mb-4">
                <Fragment set:html={formatInline(module.data.summary)} />
              </Text>

              {isShippedModule && moduleFirstExercise && (
                <div class="mb-5">
                  <ButtonLink href={exerciseHref(moduleFirstExercise.id)} variant="primary">
                    Start the first exercise →
                  </ButtonLink>
                </div>
              )}

              <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                {themes.map(({ theme, firstExercise, exerciseCount }) => (
                  <ThemeCard
                    moduleOrder={module.data.order}
                    theme={theme}
                    firstExercise={firstExercise}
                    exerciseCount={exerciseCount}
                  />
                ))}
                {themes.length === 0 && (
                  <Text tone="faint" size="sm" family="mono">
                    themes for this module are not yet drafted
                  </Text>
                )}
              </div>
              </Accordion>
            );
          })}
        </Stack>

        <Divider />

        <Stack direction="row" justify="between" align="center" wrap>
          <Text tone="muted" size="xs" family="mono">
            typeover · curriculum · pass 2
          </Text>
          <a href="/" class="text-fg-muted hover:text-fg-primary font-mono text-xs">
            ← back to home
          </a>
        </Stack>
      </Stack>
    </Container>
  </main>
</BaseLayout>
