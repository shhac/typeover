---
import BaseLayout from "~/layouts/BaseLayout.astro";
import { Container, Heading, Stack, Text } from "~/components/ds";

/*
 * Privacy note. Launch-checklist item from design-docs/07: "we use
 * localStorage, no servers, no tracking." The honest version of that
 * statement lives here, linked from the footer, so a learner can
 * confirm what the site does with their data without reading source.
 *
 * Keep it terse — there isn't much to say. If anything on this list
 * stops being true (analytics added, server-runtime endpoint, etc.),
 * update this page in the same commit.
 */
---

<BaseLayout
  title="Privacy — typeover"
  description="What typeover stores, where it lives, what leaves your device."
>
  <main class="py-12 sm:py-20">
    <Container width="default">
      <Stack gap="xl">
        <Stack gap="sm">
          <Heading level={1}>Privacy</Heading>
          <Text tone="muted" size="sm">
            The short version: typeover runs entirely in your browser.
          </Text>
        </Stack>

        <Stack gap="md">
          <Heading level={2} size="xl">What we store</Heading>
          <Text>
            typeover keeps a handful of pins in your browser's
            <code class="font-mono text-fg-primary">localStorage</code>:
          </Text>
          <ul class="ds-prose pl-6 list-disc text-fg-primary text-base">
            <li>
              <code class="font-mono">typeover:progress</code>
              — which exercises you've passed, how many hints you used,
              when you last opened an exercise. Per-device only.
            </li>
            <li>
              <code class="font-mono">typeover:theme</code>
              — your chosen colour theme. If you haven't pinned one we
              follow your OS preference.
            </li>
            <li>
              <code class="font-mono">typeover:density</code> +
              <code class="font-mono">typeover:radius</code>
              — your appearance preferences (compact / normal / airy
              spacing and sharp / normal / rounded corners).
            </li>
            <li>
              If a progress payload ever fails validation, the original
              is copied to
              <code class="font-mono">typeover:progress:corrupt-&lt;timestamp&gt;</code>
              before we reset — so a future forensic pass can recover
              what was there. No data is silently lost.
            </li>
          </ul>
        </Stack>

        <Stack gap="md">
          <Heading level={2} size="xl">What leaves your device</Heading>
          <ul class="ds-prose pl-6 list-disc text-fg-primary text-base">
            <li>
              Nothing about you or your progress. There are no
              analytics, no cookies, no third-party trackers, no
              server-side accounts.
            </li>
            <li>
              Page assets and Google Fonts load from CDNs the way any
              static site's do.
            </li>
            <li>
              If you tap <strong>Share</strong> on a module-completion
              screen, that uses your operating system's share sheet
              (or your clipboard) — the text and link go wherever you
              send them. typeover doesn't see it.
            </li>
          </ul>
        </Stack>

        <Stack gap="md">
          <Heading level={2} size="xl">Code execution</Heading>
          <Text>
            Go code you type into freeform and fill-line exercises runs in a
            WebAssembly Go interpreter (Yaegi) inside a Web Worker — on
            your device, not on any server. Your code never leaves the
            browser tab.
          </Text>
        </Stack>

        <Stack gap="md">
          <Heading level={2} size="xl">Clearing your data</Heading>
          <Text>
            Clearing site data in your browser (or using an incognito
            window) wipes everything typeover knows about you. There's no
            "delete my account" form because there's no account.
          </Text>
        </Stack>

        <Stack gap="sm">
          <Text tone="muted" size="sm">
            Questions? Open an issue on
            <a
              href="https://github.com/paulsomers/typeover"
              class="text-accent-amber hover:underline"
              rel="noopener noreferrer">GitHub</a
            >.
          </Text>
        </Stack>
      </Stack>
    </Container>
  </main>
</BaseLayout>
