---
import BaseLayout from "~/layouts/BaseLayout.astro";
import {
  Badge,
  Button,
  CodeBlock,
  Compare,
  Container,
  Divider,
  Eyebrow,
  Heading,
  Kbd,
  LangCrumbs,
  Stack,
  Text,
} from "~/components/ds";

/*
 * Landing page. Three rhythms separated by hairlines per
 * design-docs/15 patterns 1 + 4 + 8:
 *   - hero (title + dek + actions)
 *   - example (shared-caption side-by-side TS/Go via <Compare>)
 *   - DS index (small mono eyebrow per group; no panel chrome)
 *
 * Replaces the prior "h4 block label + grid of labelled panels"
 * Confluence rhythm.
 */
---

<BaseLayout
  title="typeover — learn Go from TypeScript"
  description="A bilingual learning site that teaches Go to TypeScript developers."
>
  <main class="py-16">
    <Container width="wide">
      <Stack gap="xl">
        {/* Hero */}
        <Stack gap="md">
          <LangCrumbs>
            <Badge variant="amber">v0.0.0 — hello world</Badge>
          </LangCrumbs>
          <Heading level={1}>
            <span class="text-accent-ts">type</span><span class="text-accent-amber">over</span>
          </Heading>
          <Text tone="secondary" size="lg">
            Learn Go from your TypeScript knowledge. Side-by-side translation,
            multiple choice, fill-in-the-tile, and code-runner exercises —
            scaffolded so you build real intuition, not just syntax recognition.
          </Text>
          <Stack direction="row" gap="sm" wrap>
            <a href="/go/foundations/variables/01" class="inline-flex">
              <Button variant="primary" size="md">Start learning</Button>
            </a>
            <a href="/go" class="inline-flex">
              <Button variant="secondary" size="md">Browse curriculum</Button>
            </a>
            {/* Shortcuts button removed 2026-05-20 — was a first-class
              * CTA that did nothing. Per design-docs/99: re-add when
              * there are ≥3 site-wide shortcuts worth documenting. */}
          </Stack>
        </Stack>

        <Divider />

        {/* Side-by-side example */}
        <Stack gap="sm">
          <Eyebrow>example</Eyebrow>
          <Compare
            caption="Each lesson presents a TS snippet and its Go counterpart, then asks you to identify, translate, or write the equivalent."
          >
            <CodeBlock lang="ts" filename="users.ts">{`type User = {
  id: string;
  name: string;
};

function greet(u: User) {
  return \`hi \${u.name}\`;
}`}</CodeBlock>
            <CodeBlock lang="go" filename="users.go">{`type User struct {
    ID   string
    Name string
}

func greet(u User) string {
    return "hi " + u.Name
}`}</CodeBlock>
          </Compare>
        </Stack>

        <Divider />

        {/* Design system inventory — small mono eyebrows per group,
            no panel-label chrome. */}
        <Stack gap="md">
          <Eyebrow>design system</Eyebrow>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-x-10 gap-y-8">
            <Stack gap="xs">
              <Eyebrow tone="amber">buttons</Eyebrow>
              <Stack direction="row" gap="sm" wrap>
                <Button variant="primary">Primary</Button>
                <Button variant="secondary">Secondary</Button>
                <Button variant="ghost">Ghost</Button>
                <Button variant="danger">Danger</Button>
              </Stack>
            </Stack>

            <Stack gap="xs">
              <Eyebrow tone="ts">badges</Eyebrow>
              <Stack direction="row" gap="sm" wrap>
                <Badge>default</Badge>
                <Badge variant="ts">typescript</Badge>
                <Badge variant="go">golang</Badge>
                <Badge variant="amber">focus</Badge>
                <Badge variant="success">passed</Badge>
                <Badge variant="error">failed</Badge>
              </Stack>
            </Stack>

            <Stack gap="xs">
              <Eyebrow tone="go">keys</Eyebrow>
              <Stack direction="row" gap="sm" align="center">
                <Kbd>⌘</Kbd>
                <Kbd>K</Kbd>
                <Text tone="muted" size="sm" family="mono">open palette</Text>
              </Stack>
            </Stack>

            <Stack gap="xs">
              <Eyebrow tone="muted">tones</Eyebrow>
              <Stack gap="xs">
                <Text tone="primary">Primary — main reading text</Text>
                <Text tone="secondary">Secondary — supporting prose</Text>
                <Text tone="muted">Muted — captions and hints</Text>
                <Text tone="faint">Faint — barely-there metadata</Text>
              </Stack>
            </Stack>
          </div>
        </Stack>

        <Divider />

        <Stack direction="row" justify="between" align="center">
          <Text tone="muted" size="xs" family="mono">
            typeover · 2026 · built with astro + solid + tailwind
          </Text>
          <Text tone="faint" size="xs" family="mono">
            yaegi runtime · in browser
          </Text>
        </Stack>
      </Stack>
    </Container>
  </main>
</BaseLayout>
