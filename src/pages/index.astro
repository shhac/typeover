---
import { getCollection } from "astro:content";
import BaseLayout from "~/layouts/BaseLayout.astro";
import {
  Button,
  Container,
  Heading,
  Stack,
  Text,
} from "~/components/ds";
import TrackCard from "~/components/ds/TrackCard.astro";
import { HomepageDrill } from "~/components/home/HomepageDrill";

/*
 * Landing page — design-docs/15 pattern 11. The structural
 * commitment: the homepage treats Go as the first of many
 * language tracks. A second language (Rust/Zig/Python/…) lands
 * as another <TrackCard> below this one with no homepage
 * restructure.
 *
 * Rhythm: hero → language-neutral translation drill → track cards
 * TrackCard → future-language slot → footer. The DS inventory
 * has moved off this page — see /design-system.
 */

/* design-docs/19 F-22 — the TrackCard dek used to say "54
 * exercises across six themes" as static prose. Author 4 new
 * exercises and the homepage silently lies until someone notices.
 * Compute both numbers from the content collection at build time. */
const [
  foundationsThemes,
  foundationsExercises,
  zigThemes,
  zigExercises,
  rustThemes,
  rustExercises,
] = await Promise.all([
  getCollection("themes", (t) => t.data.moduleId === "go/foundations"),
  getCollection("exercises", (ex) => ex.data.themeId.startsWith("go/foundations/")),
  getCollection("themes", (t) => t.data.target === "zig"),
  getCollection("exercises", (ex) => ex.data.target === "zig"),
  getCollection("themes", (t) => t.data.target === "rust"),
  getCollection("exercises", (ex) => ex.data.target === "rust"),
]);
const foundationsExerciseCount = foundationsExercises.length;
const foundationsThemeCount = foundationsThemes.length;
const zigExerciseCount = zigExercises.length;
const zigThemeCount = zigThemes.length;
const rustExerciseCount = rustExercises.length;
const rustThemeCount = rustThemes.length;
---

<BaseLayout
  title="typeover — learn Go, Zig, and Rust from TypeScript"
  description="A learning site that teaches Go, Zig, and Rust to TypeScript developers."
>
  <main class="py-16">
    <Container width="wide">
      <Stack gap="xl">
        {/* Hero */}
        <Stack gap="lg">
          <Heading level={1}>
            <span class="text-accent-ts">type</span><span class="text-accent-primary">over</span>
          </Heading>
          <Stack gap="md" class="max-w-3xl">
            <Text tone="secondary" size="lg">
              Learn Go, Zig, and Rust by translating from TypeScript you
              already understand. Short drills, real syntax, runnable code,
              and hints only when you ask for them.
            </Text>
            <Text tone="muted" size="sm">
              Built for developers who don't need another programming intro;
              they need their TypeScript reflexes reshaped for the next language.
            </Text>
          </Stack>
        </Stack>

        <HomepageDrill client:visible />

        {/* Track offerings — Go today, future targets stack
            alongside or below. */}
        <Stack gap="md">
          <TrackCard status="available">
            <Heading level={2} size="2xl" slot="title">
              <span class="text-accent-go">Go</span> for TypeScript devs
            </Heading>
            <Fragment slot="dek">
              Module 1 (Foundations) ships {foundationsExerciseCount} exercises
              across {foundationsThemeCount} themes — variables, numeric primitives,
              strings, conditionals, loops, functions and multi-return. Modules 2-7
              cover collections, types, interfaces, errors, concurrency, and idioms.
            </Fragment>
            <Stack gap="xs" slot="modules">
              <Text tone="muted" size="sm" family="mono">
                <span class="text-accent-go">1.</span> Foundations · ready
              </Text>
              <Text tone="faint" size="sm" family="mono">
                <span>2.</span> Collections · soon
              </Text>
              <Text tone="faint" size="sm" family="mono">
                <span>3.</span> Types & methods · soon
              </Text>
              <Text tone="faint" size="sm" family="mono">
                <span>4–7.</span> Interfaces, errors, concurrency, idioms · soon
              </Text>
            </Stack>
            <a href="/go/foundations/variables/01" class="inline-flex">
              <Button variant="primary" size="md">Start with Foundations</Button>
            </a>
            {/* Path matches the lang-prefixed exercise ID `go/foundations/variables/01`. */}
            <a href="/go" class="inline-flex">
              <Button variant="secondary" size="md">Browse the curriculum</Button>
            </a>
          </TrackCard>

          <TrackCard status="available">
            <Heading level={2} size="2xl" slot="title">
              <span class="text-accent-zig">Zig</span> for TypeScript devs
            </Heading>
            <Fragment slot="dek">
              Modules 1–4 (basics, types, memory, errors) ship {zigExerciseCount}
              exercises across {zigThemeCount}
              {zigThemeCount === 1 ? "theme" : "themes"}, graded by the real
              self-hosted Zig compiler running in a Web Worker. Modules 5–7
              (comptime, stdlib, idioms) follow.
            </Fragment>
            <Stack gap="xs" slot="modules">
              <Text tone="muted" size="sm" family="mono">
                <span class="text-accent-zig">1.</span> Basics · ready
              </Text>
              <Text tone="muted" size="sm" family="mono">
                <span class="text-accent-zig">2.</span> Types · ready
              </Text>
              <Text tone="muted" size="sm" family="mono">
                <span class="text-accent-zig">3.</span> Memory · ready
              </Text>
              <Text tone="muted" size="sm" family="mono">
                <span class="text-accent-zig">4.</span> Errors · ready
              </Text>
              <Text tone="faint" size="sm" family="mono">
                <span>5–7.</span> Comptime, stdlib, idioms · soon
              </Text>
            </Stack>
            <a href="/zig/basics/hello-and-output/01" class="inline-flex">
              <Button variant="primary" size="md">Start with Basics</Button>
            </a>
            <a href="/zig" class="inline-flex">
              <Button variant="secondary" size="md">Browse the curriculum</Button>
            </a>
          </TrackCard>

          <TrackCard status="available">
            <Heading level={2} size="2xl" slot="title">
              <span class="text-accent-rust">Rust</span> for TypeScript devs
            </Heading>
            <Fragment slot="dek">
              Foundations ships {rustExerciseCount} runnable exercises today,
              graded by a server-compile pipeline (Vercel Sandbox → wasm
              → in-browser run) with a service-worker L1 cache so canonical
              answers never burn Vercel CPU. Modules 2–7 ship their theme
              spines today — {rustThemeCount} themes across all modules — with
              exercises arriving next.
            </Fragment>
            <Stack gap="xs" slot="modules">
              <Text tone="muted" size="sm" family="mono">
                <span class="text-accent-rust">1.</span> Foundations · partial
              </Text>
              <Text tone="faint" size="sm" family="mono">
                <span>2.</span> Ownership &amp; borrowing · spine
              </Text>
              <Text tone="faint" size="sm" family="mono">
                <span>3.</span> Data modeling · spine
              </Text>
              <Text tone="faint" size="sm" family="mono">
                <span>4.</span> Collections &amp; iteration · spine
              </Text>
              <Text tone="faint" size="sm" family="mono">
                <span>5.</span> Errors, crates &amp; tests · spine
              </Text>
              <Text tone="faint" size="sm" family="mono">
                <span>6.</span> Traits &amp; generics · spine
              </Text>
              <Text tone="faint" size="sm" family="mono">
                <span>7.</span> Production Rust · spine
              </Text>
            </Stack>
            <a href="/rust/foundations/hello-and-printing/01" class="inline-flex">
              <Button variant="primary" size="md">Start with Foundations</Button>
            </a>
            <a href="/rust" class="inline-flex">
              <Button variant="secondary" size="md">Browse the curriculum</Button>
            </a>
          </TrackCard>
        </Stack>

        <Stack direction="row" justify="between" align="center" wrap>
          <Text tone="muted" size="xs" family="mono">
            typeover · 2026 · built with astro + solid + tailwind
          </Text>
          <Text tone="faint" size="xs" family="mono">
            yaegi + zig in browser · rust server-compiled + SW-cached
          </Text>
        </Stack>
      </Stack>
    </Container>
  </main>
</BaseLayout>
