---
import { getCollection } from "astro:content";
import BaseLayout from "~/layouts/BaseLayout.astro";
import {
  Badge,
  Button,
  CodeBlock,
  Compare,
  Container,
  Divider,
  Eyebrow,
  Heading,
  LangCrumbs,
  Stack,
  Text,
} from "~/components/ds";
import TrackCard from "~/components/ds/TrackCard.astro";

/*
 * Landing page — design-docs/15 pattern 11. The structural
 * commitment: the homepage treats Go as the first of many
 * language tracks. A second language (Rust/Zig/Python/…) lands
 * as another <TrackCard> below this one with no homepage
 * restructure.
 *
 * Rhythm: hero → TS↔Go wedge example → "what's on offer" Go
 * TrackCard → future-language slot → footer. The DS inventory
 * has moved off this page — see /design-system.
 */

/* design-docs/19 F-22 — the TrackCard dek used to say "54
 * exercises across six themes" as static prose. Author 4 new
 * exercises and the homepage silently lies until someone notices.
 * Compute both numbers from the content collection at build time. */
const [foundationsThemes, foundationsExercises, zigThemes, zigExercises] = await Promise.all([
  getCollection("themes", (t) => t.data.moduleId === "go/foundations"),
  getCollection("exercises", (ex) => ex.data.themeId.startsWith("go/foundations/")),
  getCollection("themes", (t) => t.data.target === "zig"),
  getCollection("exercises", (ex) => ex.data.target === "zig"),
]);
const foundationsExerciseCount = foundationsExercises.length;
const foundationsThemeCount = foundationsThemes.length;
const zigExerciseCount = zigExercises.length;
const zigThemeCount = zigThemes.length;
---

<BaseLayout
  title="typeover — learn Go from TypeScript"
  description="A bilingual learning site that teaches Go to TypeScript developers."
>
  <main class="py-16">
    <Container width="wide">
      <Stack gap="xl">
        {/* Hero */}
        <Stack gap="md">
          <LangCrumbs>
            <Badge variant="primary">v0.0.0 — hello world</Badge>
          </LangCrumbs>
          <Heading level={1}>
            <span class="text-accent-ts">type</span><span class="text-accent-primary">over</span>
          </Heading>
          <Text tone="secondary" size="lg">
            A bilingual learning site that bridges the languages you
            already know to the ones you want next. Side-by-side
            translation, multiple choice, fill-in-the-tile, and
            code-runner exercises — scaffolded so you build real
            intuition, not just syntax recognition.
          </Text>
        </Stack>

        <Divider />

        {/* Side-by-side example */}
        <Stack gap="sm">
          <Eyebrow>the wedge</Eyebrow>
          <Compare
            caption="Each lesson presents the source language and its target counterpart, then asks you to identify, translate, or write the equivalent."
          >
            <CodeBlock lang="ts" filename="users.ts">{`type User = {
  id: string;
  name: string;
};

function greet(u: User) {
  return \`hi \${u.name}\`;
}`}</CodeBlock>
            <CodeBlock lang="go" filename="users.go">{`type User struct {
    ID   string
    Name string
}

func greet(u User) string {
    return "hi " + u.Name
}`}</CodeBlock>
          </Compare>
        </Stack>

        <Divider />

        {/* Track offerings — Go today, future targets stack
            alongside or below. */}
        <Stack gap="md">
          <Eyebrow>tracks</Eyebrow>

          <TrackCard status="available">
            <Heading level={2} size="2xl" slot="title">
              <span class="text-accent-go">Go</span> for TypeScript devs
            </Heading>
            <Fragment slot="dek">
              Module 1 (Foundations) ships {foundationsExerciseCount} exercises
              across {foundationsThemeCount} themes — variables, numeric primitives,
              strings, conditionals, loops, functions and multi-return. Modules 2-7
              cover collections, types, interfaces, errors, concurrency, and idioms.
            </Fragment>
            <Stack gap="xs" slot="modules">
              <Text tone="muted" size="sm" family="mono">
                <span class="text-accent-go">1.</span> Foundations · ready
              </Text>
              <Text tone="faint" size="sm" family="mono">
                <span>2.</span> Collections · soon
              </Text>
              <Text tone="faint" size="sm" family="mono">
                <span>3.</span> Types & methods · soon
              </Text>
              <Text tone="faint" size="sm" family="mono">
                <span>4–7.</span> Interfaces, errors, concurrency, idioms · soon
              </Text>
            </Stack>
            <a href="/go/foundations/variables/01" class="inline-flex">
              <Button variant="primary" size="md">Start with Foundations</Button>
            </a>
            {/* Path matches the lang-prefixed exercise ID `go/foundations/variables/01`. */}
            <a href="/go" class="inline-flex">
              <Button variant="secondary" size="md">Browse the curriculum</Button>
            </a>
          </TrackCard>

          <TrackCard status="available">
            <Heading level={2} size="2xl" slot="title">
              <span class="text-accent-zig">Zig</span> for TypeScript devs
            </Heading>
            <Fragment slot="dek">
              Preview track — {zigExerciseCount} exercises across
              {zigThemeCount} {zigThemeCount === 1 ? "theme" : "themes"} so far,
              graded by the real self-hosted Zig compiler running in a Web Worker.
              Modules ramp from basics → types → memory → errors → comptime →
              stdlib → idioms.
            </Fragment>
            <Stack gap="xs" slot="modules">
              <Text tone="muted" size="sm" family="mono">
                <span class="text-accent-zig">1.</span> Basics · preview (hello + output)
              </Text>
              <Text tone="faint" size="sm" family="mono">
                <span>2–7.</span> Types, memory, errors, comptime, stdlib, idioms · soon
              </Text>
            </Stack>
            <a href="/zig/basics/hello-and-output/01" class="inline-flex">
              <Button variant="primary" size="md">Try the preview</Button>
            </a>
            <a href="/zig" class="inline-flex">
              <Button variant="secondary" size="md">Browse the curriculum</Button>
            </a>
          </TrackCard>

          <TrackCard status="soon">
            <Heading level={2} size="2xl" slot="title">
              <span class="text-fg-secondary">Rust</span> for TypeScript devs
            </Heading>
            <Fragment slot="dek">
              A future track. Same bilingual progression — same
              recognition → fill-in → freeform shape — for the
              ownership / borrowing / lifetime moves Rust asks of you.
              (Status: no embeddable Rust interpreter exists yet, so a
              client-side runtime is on hold.)
            </Fragment>
            <Stack gap="xs" slot="modules">
              <Text tone="faint" size="sm" family="mono">
                proposed; blocked on runtime feasibility
              </Text>
            </Stack>
            <Button variant="ghost" size="md" disabled>Coming later</Button>
          </TrackCard>
        </Stack>

        <Divider />

        <Stack direction="row" justify="between" align="center" wrap>
          <Text tone="muted" size="xs" family="mono">
            typeover · 2026 · built with astro + solid + tailwind
          </Text>
          <Text tone="faint" size="xs" family="mono">
            yaegi + zig runtimes · in browser
          </Text>
        </Stack>
      </Stack>
    </Container>
  </main>
</BaseLayout>
