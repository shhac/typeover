---
import "~/styles/global.css";
import { ResumeLink } from "~/components/header/ResumeLink";
import { NAV_LINK_CLASS } from "~/components/ds/NavLink";

interface Props {
  title: string;
  description?: string;
  /** When set, the header renders compact `←` / `→` chrome links
   *  next to ResumeLink so the learner can step between adjacent
   *  exercises without re-finding the toolbar. Used by the
   *  exercise route; other pages omit. */
  prevExerciseHref?: string;
  nextExerciseHref?: string;
}

const { title, description, prevExerciseHref, nextExerciseHref } = Astro.props;

/* Canonical URL for the deploy. Used for og:url + the absolute
 * og:image URL — some social platforms (notably LinkedIn and
 * old-school crawlers) refuse relative image paths. Falls back to
 * a sensible literal so dev / preview builds don't break. */
const SITE_ORIGIN = import.meta.env.SITE ?? "https://typeover.paulie.app";
const ogImage = new URL("/og-image.svg", SITE_ORIGIN).toString();
const pageUrl = new URL(Astro.url.pathname, SITE_ORIGIN).toString();

/* Preload the runtime WASM on track routes so the brotli download
 * happens in parallel with HTML parsing instead of waiting for the
 * first `getRunner()` call inside a Solid island. Cuts the cold-start
 * latency a learner perceives between landing on an exercise route
 * and clicking Run.
 *
 * Gated to /go/<...> and /zig/<...> paths to avoid loading the WASM
 * for /, /settings, /privacy, /design-system etc. MCQ and fill-word
 * exercises never call getRunner() either, but the route-level gate
 * is the pragmatic v0 cut — refining further means a per-exercise-
 * type preload signal we don't currently surface. design-docs/20
 * proposer-cycle round 2 — the lighter alternative to a service
 * worker.
 *
 * For Zig we preload only zig.wasm (~900 KB brotli); the heavier
 * stdlib tarball is lazy-loaded by the worker on first eval(). */
const path = Astro.url.pathname;
const preloadWasm: { href: string } | null = path.startsWith("/go/")
  ? { href: "/yaegi/yaegi.wasm" }
  : path.startsWith("/zig/")
    ? { href: "/zig/zig.wasm" }
    : null;
const isExerciseRoute = preloadWasm !== null;

/* Inline pre-bundle script bodies. Both ship as strings so we can
 * write them verbatim via `<script is:inline set:html={…}>` and
 * regex-test against the constants rather than scraping the
 * layout's front-matter. */
import { runtimePrefetchScript } from "~/lib/runtime-prefetch-script";
import { appearanceBootstrapScript } from "./appearance-bootstrap.inline";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    {description && <meta name="description" content={description} />}
    {/*
     * Appearance bootstrap — runs synchronously before paint to set
     * three data-* attributes on <html> from the learner's pins
     * (localStorage) or per-axis defaults. Prevents flash-of-wrong-
     * theme on first frame for all three axes. Keep this inline and
     * small; any growth lives in src/lib/theme.ts. See
     * design-docs/13-themes.md + 14-stylistic-themes.md.
     */}
    <script is:inline set:html={appearanceBootstrapScript}></script>
    <link rel="canonical" href={pageUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {preloadWasm && (
      <link rel="preload" href={preloadWasm.href} as="fetch" type="application/wasm" crossorigin="anonymous" />
    )}
    {/* Hover/focus prefetch of the runtime WASM from off-route pages
      * (landing, lang index, privacy). On track routes the
      * <link rel="preload"> above already covers it.
      * design-docs/25 P5. */}
    {!isExerciseRoute && <script is:inline set:html={runtimePrefetchScript} />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500;600&display=swap"
    />

    {/* Open Graph + Twitter share card. Absolute URLs because some
      * platforms (LinkedIn especially) refuse relative paths. */}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    <meta name="twitter:image" content={ogImage} />

    <title>{title}</title>
  </head>
  <body class="flex flex-col min-h-screen">
    {/*
      * Site-wide brand anchor — always-present link to home.
      * design-docs/15 pattern 9. Suppressed on the homepage itself
      * (the hero IS the brand anchor there), so the wordmark
      * doesn't repeat itself two lines apart.
      */}
    {Astro.url.pathname !== "/" && (
      <header
        class="border-b border-border-default text-xs font-mono"
      >
        <div class="mx-auto px-4 sm:px-8 w-full max-w-6xl py-3 flex flex-row justify-between items-center gap-3 sm:gap-4">
          <a
            href="/"
            class="text-fg-secondary hover:text-fg-primary transition-colors focus-ring shrink-0"
            aria-label="typeover — back to home"
          >
            <span class="text-accent-ts">type</span><span class="text-accent-primary">over</span>
          </a>
          {/* Exercise nav arrows + resume link, grouped as one
            * chrome strip. `min-w-0` lets the ResumeLink truncate
            * inside the flex row on narrow viewports instead of
            * forcing the whole header to overflow. On mobile, the
            * resume label hides itself (see ResumeLink); the
            * arrows alone keep the navigation reachable in ~60px. */}
          <div class="flex flex-row items-center gap-1 sm:gap-2 min-w-0">
            {prevExerciseHref && (
              <a
                href={prevExerciseHref}
                class={`${NAV_LINK_CLASS} px-1 shrink-0`}
                aria-label="Previous exercise"
              >
                ←
              </a>
            )}
            <ResumeLink client:only="solid-js" />
            {nextExerciseHref && (
              <a
                href={nextExerciseHref}
                class={`${NAV_LINK_CLASS} px-1 shrink-0`}
                aria-label="Next exercise"
              >
                →
              </a>
            )}
          </div>
          {Astro.url.pathname !== "/go" && (
            <a href="/go" class={`${NAV_LINK_CLASS} shrink-0`}>
              curriculum<span class="hidden sm:inline"> →</span>
            </a>
          )}
        </div>
      </header>
    )}
    <div class="flex-1">
      <slot />
    </div>
    {/*
      * Site-wide footer — minimal chrome carrying the discoverable
      * routes that don't fit in the curriculum tree:
      *   - Settings (theme picker, per design-docs/13).
      *   - GitHub repo (build-in-public posture per design-docs/07).
      * Anything richer (newsletter, social, contact) waits until
      * the launch checklist demands it.
      */}
    <footer
      class="mt-12 py-6 border-t border-border-default text-fg-muted text-xs font-mono"
    >
      <div class="mx-auto px-6 sm:px-8 w-full max-w-6xl flex flex-row gap-6 flex-wrap">
        <a
          href="/"
          class="hover:text-fg-secondary transition-colors focus-ring"
        >
          typeover
        </a>
        <a
          href="/go"
          class="hover:text-fg-secondary transition-colors focus-ring"
        >
          curriculum
        </a>
        <a
          href="/settings"
          class="hover:text-fg-secondary transition-colors focus-ring"
        >
          settings
        </a>
        <a
          href="/privacy"
          class="hover:text-fg-secondary transition-colors focus-ring"
        >
          privacy
        </a>
        <a
          href="https://github.com/paulsomers/typeover"
          target="_blank"
          rel="noopener noreferrer"
          class="hover:text-fg-secondary transition-colors focus-ring"
        >
          github ↗
        </a>
      </div>
    </footer>
  </body>
</html>
