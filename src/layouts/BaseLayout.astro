---
import "~/styles/global.css";

interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;

/* Canonical URL for the deploy. Used for og:url + the absolute
 * og:image URL — some social platforms (notably LinkedIn and
 * old-school crawlers) refuse relative image paths. Falls back to
 * a sensible literal so dev / preview builds don't break. */
const SITE_ORIGIN = import.meta.env.SITE ?? "https://typeover.paulie.app";
const ogImage = new URL("/og-image.svg", SITE_ORIGIN).toString();
const pageUrl = new URL(Astro.url.pathname, SITE_ORIGIN).toString();

/* Preload the Yaegi WASM on /go/* routes so the ~1.9 MB brotli
 * download happens in parallel with HTML parsing instead of waiting
 * for the first `getRunner()` call inside a Solid island. Cuts the
 * cold-start latency a learner perceives between landing on an
 * exercise route and clicking Run.
 *
 * Gated to /go/* paths to avoid loading the WASM for /, /settings,
 * /privacy, /design-system etc. MCQ and fill-word exercises never
 * call getRunner() either, but the route-level gate is the
 * pragmatic v0 cut — refining further means a per-exercise-type
 * preload signal we don't currently surface. design-docs/20
 * proposer-cycle round 2 — the lighter alternative to a service
 * worker. */
const isExerciseRoute = Astro.url.pathname.startsWith("/go/");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    {description && <meta name="description" content={description} />}
    {/*
     * Appearance bootstrap — runs synchronously before paint to set
     * three data-* attributes on <html> from the learner's pins
     * (localStorage) or per-axis defaults. Prevents flash-of-wrong-
     * theme on first frame for all three axes. Keep this inline and
     * small; any growth lives in src/lib/theme.ts. See
     * design-docs/13-themes.md + 14-stylistic-themes.md.
     */}
    <script is:inline>
      (() => {
        try {
          var pinnedTheme = localStorage.getItem("typeover:theme");
          var theme =
            pinnedTheme === "dark" || pinnedTheme === "light"
              ? pinnedTheme
              : window.matchMedia("(prefers-color-scheme: light)").matches
                ? "light"
                : "dark";
          document.documentElement.dataset.theme = theme;

          var pinnedDensity = localStorage.getItem("typeover:density");
          document.documentElement.dataset.density =
            pinnedDensity === "compact" ||
            pinnedDensity === "normal" ||
            pinnedDensity === "airy"
              ? pinnedDensity
              : "normal";

          var pinnedRadius = localStorage.getItem("typeover:radius");
          document.documentElement.dataset.radius =
            pinnedRadius === "sharp" ||
            pinnedRadius === "normal" ||
            pinnedRadius === "rounded" ||
            pinnedRadius === "pill"
              ? pinnedRadius
              : "normal";

          var pinnedStyle = localStorage.getItem("typeover:style");
          var style =
            pinnedStyle === "terminal" ||
            pinnedStyle === "cardboard" ||
            pinnedStyle === "textbook" ||
            pinnedStyle === "glass" ||
            pinnedStyle === "islands"
              ? pinnedStyle
              : "terminal";
          document.documentElement.dataset.style = style;

          /* Palette resolution per design-docs/22 — `default` (or
           * absent) follows the active style's default; a specific
           * palette ID persists across style switches. The list
           * below must stay in sync with PALETTES + STYLE_DEFAULT_PALETTE
           * in src/lib/theme.ts — bootstrap.test asserts every
           * literal appears. */
          var styleDefaultPalette = {
            terminal: "phosphor-amber",
            cardboard: "warm-paper",
            textbook: "parchment-ink",
            glass: "aurora-amber",
            islands: "desk-felt",
          };
          var palettes = [
            "phosphor-amber", "phosphor-green", "ice-blue", "tape-reel",
            "warm-paper", "kraft", "manila", "newsprint", "calfskin",
            "parchment-ink", "vellum", "pelican", "sepia", "almanac",
            "aurora-amber", "glacier-blue", "lavender-mist", "monochrome",
            "desk-felt", "app-store", "dark-wood", "studio-grey", "sunlit-pine",
          ];
          var pinnedPalette = localStorage.getItem("typeover:palette");
          document.documentElement.dataset.palette =
            pinnedPalette && pinnedPalette !== "default" && palettes.indexOf(pinnedPalette) >= 0
              ? pinnedPalette
              : styleDefaultPalette[style];
        } catch (_) {
          /* localStorage unavailable (incognito quota / SSR / etc.) —
           * fall through to the CSS @theme defaults. */
        }
      })();
    </script>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {isExerciseRoute && (
      <link rel="preload" href="/yaegi/yaegi.wasm" as="fetch" type="application/wasm" crossorigin="anonymous" />
    )}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500;600&display=swap"
    />

    {/* Open Graph + Twitter share card. Absolute URLs because some
      * platforms (LinkedIn especially) refuse relative paths. */}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    <meta name="twitter:image" content={ogImage} />

    <title>{title}</title>
  </head>
  <body class="flex flex-col min-h-screen">
    {/*
      * Site-wide brand anchor — always-present link to home.
      * design-docs/15 pattern 9. Suppressed on the homepage itself
      * (the hero IS the brand anchor there), so the wordmark
      * doesn't repeat itself two lines apart.
      */}
    {Astro.url.pathname !== "/" && (
      <header
        class="border-b border-border-default text-xs font-mono"
      >
        <div class="mx-auto px-6 sm:px-8 w-full max-w-6xl py-3 flex flex-row justify-between items-center">
          <a
            href="/"
            class="text-fg-secondary hover:text-fg-primary transition-colors focus-ring"
            aria-label="typeover — back to home"
          >
            <span class="text-accent-ts">type</span><span class="text-accent-primary">over</span>
          </a>
          {Astro.url.pathname !== "/go" && (
            <a
              href="/go"
              class="text-fg-muted hover:text-fg-secondary transition-colors focus-ring"
            >
              curriculum →
            </a>
          )}
        </div>
      </header>
    )}
    <div class="flex-1">
      <slot />
    </div>
    {/*
      * Site-wide footer — minimal chrome carrying the discoverable
      * routes that don't fit in the curriculum tree:
      *   - Settings (theme picker, per design-docs/13).
      *   - GitHub repo (build-in-public posture per design-docs/07).
      * Anything richer (newsletter, social, contact) waits until
      * the launch checklist demands it.
      */}
    <footer
      class="mt-12 py-6 border-t border-border-default text-fg-muted text-xs font-mono"
    >
      <div class="mx-auto px-6 sm:px-8 w-full max-w-6xl flex flex-row gap-6 flex-wrap">
        <a
          href="/"
          class="hover:text-fg-secondary transition-colors focus-ring"
        >
          typeover
        </a>
        <a
          href="/go"
          class="hover:text-fg-secondary transition-colors focus-ring"
        >
          curriculum
        </a>
        <a
          href="/settings"
          class="hover:text-fg-secondary transition-colors focus-ring"
        >
          settings
        </a>
        <a
          href="/privacy"
          class="hover:text-fg-secondary transition-colors focus-ring"
        >
          privacy
        </a>
        <a
          href="https://github.com/paulsomers/typeover"
          target="_blank"
          rel="noopener noreferrer"
          class="hover:text-fg-secondary transition-colors focus-ring"
        >
          github ↗
        </a>
      </div>
    </footer>
  </body>
</html>
