---
import "~/styles/global.css";

interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;

/* Canonical URL for the deploy. Used for og:url + the absolute
 * og:image URL — some social platforms (notably LinkedIn and
 * old-school crawlers) refuse relative image paths. Falls back to
 * a sensible literal so dev / preview builds don't break. */
const SITE_ORIGIN = import.meta.env.SITE ?? "https://typeover.paulie.app";
const ogImage = new URL("/og-image.svg", SITE_ORIGIN).toString();
const pageUrl = new URL(Astro.url.pathname, SITE_ORIGIN).toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    {description && <meta name="description" content={description} />}
    {/*
     * Theme bootstrap — runs synchronously before paint to set
     * data-theme on <html> from the learner's pin (localStorage) or
     * the OS preference. Prevents flash-of-wrong-theme on first
     * frame. Keep this inline and small; any growth lives in
     * src/lib/theme.ts (which the settings page uses). See
     * design-docs/13-themes.md.
     */}
    <script is:inline>
      (() => {
        try {
          var pinned = localStorage.getItem("typeover:theme");
          var theme =
            pinned === "dark" || pinned === "light"
              ? pinned
              : window.matchMedia("(prefers-color-scheme: light)").matches
                ? "light"
                : "dark";
          document.documentElement.dataset.theme = theme;
        } catch (_) {
          /* localStorage unavailable (incognito quota / SSR / etc.) —
           * fall through to the CSS @theme defaults (dark). */
        }
      })();
    </script>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500;600&display=swap"
    />

    {/* Open Graph + Twitter share card. Absolute URLs because some
      * platforms (LinkedIn especially) refuse relative paths. */}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    <meta name="twitter:image" content={ogImage} />

    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
