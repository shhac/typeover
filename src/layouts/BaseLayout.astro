---
import "~/styles/global.css";

interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;

/* Canonical URL for the deploy. Used for og:url + the absolute
 * og:image URL — some social platforms (notably LinkedIn and
 * old-school crawlers) refuse relative image paths. Falls back to
 * a sensible literal so dev / preview builds don't break. */
const SITE_ORIGIN = import.meta.env.SITE ?? "https://typeover.paulie.app";
const ogImage = new URL("/og-image.svg", SITE_ORIGIN).toString();
const pageUrl = new URL(Astro.url.pathname, SITE_ORIGIN).toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    {description && <meta name="description" content={description} />}
    {/*
     * Appearance bootstrap — runs synchronously before paint to set
     * three data-* attributes on <html> from the learner's pins
     * (localStorage) or per-axis defaults. Prevents flash-of-wrong-
     * theme on first frame for all three axes. Keep this inline and
     * small; any growth lives in src/lib/theme.ts. See
     * design-docs/13-themes.md + 14-stylistic-themes.md.
     */}
    <script is:inline>
      (() => {
        try {
          var pinnedTheme = localStorage.getItem("typeover:theme");
          var theme =
            pinnedTheme === "dark" || pinnedTheme === "light"
              ? pinnedTheme
              : window.matchMedia("(prefers-color-scheme: light)").matches
                ? "light"
                : "dark";
          document.documentElement.dataset.theme = theme;

          var pinnedDensity = localStorage.getItem("typeover:density");
          document.documentElement.dataset.density =
            pinnedDensity === "compact" ||
            pinnedDensity === "normal" ||
            pinnedDensity === "airy"
              ? pinnedDensity
              : "normal";

          var pinnedRadius = localStorage.getItem("typeover:radius");
          document.documentElement.dataset.radius =
            pinnedRadius === "sharp" ||
            pinnedRadius === "normal" ||
            pinnedRadius === "rounded"
              ? pinnedRadius
              : "normal";
        } catch (_) {
          /* localStorage unavailable (incognito quota / SSR / etc.) —
           * fall through to the CSS @theme defaults. */
        }
      })();
    </script>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500;600&display=swap"
    />

    {/* Open Graph + Twitter share card. Absolute URLs because some
      * platforms (LinkedIn especially) refuse relative paths. */}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    <meta name="twitter:image" content={ogImage} />

    <title>{title}</title>
  </head>
  <body class="flex flex-col min-h-screen">
    <div class="flex-1">
      <slot />
    </div>
    {/*
      * Site-wide footer — minimal chrome carrying the discoverable
      * routes that don't fit in the curriculum tree:
      *   - Settings (theme picker, per design-docs/13).
      *   - GitHub repo (build-in-public posture per design-docs/07).
      * Anything richer (newsletter, social, contact) waits until
      * the launch checklist demands it.
      */}
    <footer
      class="mt-12 py-6 border-t border-border-default text-fg-muted text-xs font-mono"
    >
      <div class="mx-auto px-6 sm:px-8 w-full max-w-6xl flex flex-row gap-6 flex-wrap">
        <a
          href="/"
          class="hover:text-fg-secondary transition-colors focus-visible:outline-2 focus-visible:outline-accent-amber rounded-sm"
        >
          typeover
        </a>
        <a
          href="/go"
          class="hover:text-fg-secondary transition-colors focus-visible:outline-2 focus-visible:outline-accent-amber rounded-sm"
        >
          curriculum
        </a>
        <a
          href="/settings"
          class="hover:text-fg-secondary transition-colors focus-visible:outline-2 focus-visible:outline-accent-amber rounded-sm"
        >
          settings
        </a>
        <a
          href="/privacy"
          class="hover:text-fg-secondary transition-colors focus-visible:outline-2 focus-visible:outline-accent-amber rounded-sm"
        >
          privacy
        </a>
        <a
          href="https://github.com/paulsomers/typeover"
          rel="noopener noreferrer"
          class="hover:text-fg-secondary transition-colors focus-visible:outline-2 focus-visible:outline-accent-amber rounded-sm"
        >
          github
        </a>
      </div>
    </footer>
  </body>
</html>
