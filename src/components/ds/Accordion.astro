---
/*
 * Accordion — disclosure widget for collapsing a region under a
 * clickable header. design-docs/15 pattern 10.
 *
 * Implemented as an Astro component with named slots (`summary`,
 * `meta`, default) — same pattern noted as the path forward for
 * Crumbs in design-docs/05. The Solid-component shape was rejected
 * by Astro's template parser, which disallows component tags
 * inside `{...}` attribute-value braces.
 *
 * Uses the native `<details>`/`<summary>` elements for a11y for
 * free: keyboard-operable, screen-readers announce expanded state,
 * the browser handles open/close transitions without JS.
 *
 * `defaultOpen` controls the initial state via the `open`
 * attribute. After the first user click, the browser owns the
 * state — we don't fight it by re-asserting `defaultOpen`.
 */

interface Props {
  defaultOpen?: boolean;
  class?: string;
}

const { defaultOpen = false, class: className } = Astro.props;
---

<details open={defaultOpen} class:list={["group", className]}>
  <summary
    class="list-none cursor-pointer flex flex-row items-baseline gap-3 py-2 focus-ring"
  >
    {/*
     * Caret rotates on open via CSS — `group-open:rotate-90`
     * reads the parent <details>'s `open` attribute. No JS.
     */}
    <span
      aria-hidden="true"
      class="inline-block text-fg-muted text-xs font-mono transition-transform group-open:rotate-90"
    >
      ▸
    </span>
    <span class="flex-1">
      <slot name="summary" />
    </span>
    {/*
     * Slot fallback handling: the `meta` slot's wrapper renders
     * regardless of whether content was provided, so callers
     * without a meta will get an empty mono span. Astro's
     * slot-is-empty check requires the `slot="default"` trick;
     * for v0 the empty span is harmless (no chrome of its own).
     */}
    <span class="text-fg-muted text-xs font-mono">
      <slot name="meta" />
    </span>
  </summary>
  <div class="mt-3">
    <slot />
  </div>
</details>
