---
import type { CollectionEntry } from "astro:content";
import { Badge, Heading, Panel, Stack, Text } from "~/components/ds";
import { ThemeProgressChip } from "~/components/progress/ThemeProgressChip";
import { exerciseHref, themeHref, truncateIntro } from "~/lib/curriculum";
import { formatInline } from "~/lib/format-inline";

/*
 * Theme overview card used in the curriculum grid on /go and
 * /go/<module>. Pulled out of two near-identical hand-rolled
 * Panel-Stack-Stack-Badge blocks (design-docs/20 FW-3) so the
 * card's shape — title link, intro snippet, ready badge,
 * overview + start anchors — lives in one place.
 *
 * The two routes diverged only on which "module.order" they read
 * (module.data.order vs moduleData.order, identical value); both
 * call sites now pass the parent module's order as a prop.
 *
 * `ThemeProgressChip` (reused from the theme-overview page) is
 * mounted inline when the parent has authored exercises. Renders
 * nothing when passed=0, so anonymous visitors see the unstarted
 * card unchanged; returning learners see a "3 / 9 passed" chip
 * appear next to the "ready" badge. design-docs/28 P15.
 */

interface Props {
  /** The parent module's order (the "1" in "1.2"). */
  moduleOrder: number;
  theme: CollectionEntry<"themes">;
  /** First exercise in this theme, when authored. Absent for
   *  scaffolded themes — the "start →" anchor hides in that case. */
  firstExercise: CollectionEntry<"exercises"> | undefined;
  exerciseCount: number;
  /** All exercise IDs in this theme, sorted by order. Forwarded
   *  to ThemeProgressChip so a returning learner sees their
   *  passed-count on the grid card itself. Empty array on
   *  scaffolded themes — the chip then renders nothing. */
  exerciseIds: string[];
}

const { moduleOrder, theme, firstExercise, exerciseCount, exerciseIds } = Astro.props;
const overviewHref = themeHref(theme.id);
const startHref = firstExercise ? exerciseHref(firstExercise.id) : null;
---

<Panel padding="default" tone="default">
  <Stack gap="sm">
    <Stack direction="row" gap="sm" align="baseline" wrap>
      <Text tone="faint" size="xs" family="mono">
        {moduleOrder}.{theme.data.order}
      </Text>
      <Heading level={3} size="lg">
        <a
          href={overviewHref}
          class="hover:text-accent-primary transition-colors"
        >
          {theme.data.title}
        </a>
      </Heading>
    </Stack>
    <Text tone="muted" size="sm">
      <Fragment set:html={formatInline(truncateIntro(theme.data.intro))} />
    </Text>
    <Stack direction="row" gap="sm" align="center" wrap>
      <Badge variant={exerciseCount > 0 ? "go" : "default"} outline>
        {exerciseCount > 0 ? `${exerciseCount} ready` : "coming"}
      </Badge>
      {exerciseIds.length > 0 && (
        <ThemeProgressChip client:only="solid-js" exerciseIds={exerciseIds} />
      )}
      <a
        href={overviewHref}
        class="text-fg-muted hover:text-fg-primary font-mono text-sm"
      >
        overview
      </a>
      {startHref && (
        <a
          href={startHref}
          class="text-accent-primary hover:underline font-mono text-sm"
        >
          start →
        </a>
      )}
    </Stack>
  </Stack>
</Panel>
